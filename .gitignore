# ─── Large Data Files ────────────────────────────────────────────────────────
# Instacart dataset CSVs (download from Kaggle: instacart-market-basket-analysis)
data/instacart/*.csv

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Model Artifacts (can be re-trained) ─────────────────────────────────────
models/*.pkl
models/*.joblib

# ─── Streamlit ───────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
